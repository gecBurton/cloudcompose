{
  "data": {
    "azurerm_client_config": {
      "current": {}
    },
    "azurerm_container_app_environment": {
      "main": {
        "name": "prod-env",
        "resource_group_name": "prod"
      }
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "docker": {
      "registry_auth": [
        {
          "address": "${azurerm_container_registry.main.login_server}",
          "password": "${azurerm_container_registry.main.admin_password}",
          "username": "${azurerm_container_registry.main.admin_username}"
        }
      ]
    },
    "random": {}
  },
  "resource": {
    "azurerm_container_app": {
      "web": {
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "identity": {
          "type": "SystemAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-build-webapp-web",
        "registry": [
          {
            "password_secret_name": "acr-password",
            "server": "${azurerm_container_registry.main.login_server}",
            "username": "${azurerm_container_registry.main.admin_username}"
          }
        ],
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "name": "acr-password",
            "value": "${azurerm_container_registry.main.admin_password}"
          }
        ],
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [],
              "image": "${azurerm_container_registry.main.login_server}/web@${docker_registry_image.web_push.sha256_digest}",
              "memory": "0.5Gi",
              "name": "web"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_container_registry": {
      "main": {
        "admin_enabled": true,
        "location": "eastus",
        "name": "prodacr",
        "resource_group_name": "prod",
        "sku": "Standard"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-build-webapp-kv",
        "purge_protection_enabled": false,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "docker_image": {
      "web_image": {
        "build": {
          "context": "app",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${azurerm_container_registry.main.login_server}/web:latest"
      }
    },
    "docker_registry_image": {
      "web_push": {
        "keep_remotely": true,
        "name": "${docker_image.web_image.name}"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}
