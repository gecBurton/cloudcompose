{
  "data": {
    "azurerm_client_config": {
      "current": {}
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.doctor.ingress[0].fqdn}"
    },
    "key_vault_name": {
      "description": "Name of the Key Vault holding managed-service/secrets/config credentials, if any.",
      "value": "${azurerm_key_vault.main.name}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "docker": {
      "registry_auth": [
        {
          "address": "${azurerm_container_registry.main.login_server}",
          "password": "${azurerm_container_registry.main.admin_password}",
          "username": "${azurerm_container_registry.main.admin_username}"
        }
      ]
    },
    "random": {},
    "time": {}
  },
  "resource": {
    "azurerm_container_app": {
      "doctor": {
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-doctor-doctor",
        "registry": [
          {
            "password_secret_name": "acr-password",
            "server": "${azurerm_container_registry.main.login_server}",
            "username": "${azurerm_container_registry.main.admin_username}"
          }
        ],
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "name": "acr-password",
            "value": "${azurerm_container_registry.main.admin_password}"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.doctor_database_url_url.versionless_id}",
            "name": "doctor-database-url-url"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.doctor_redis_url_url.versionless_id}",
            "name": "doctor-redis-url-url"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.db_secret.versionless_id}",
            "name": "db-url"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.cache_secret.versionless_id}",
            "name": "cache-url"
          }
        ],
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [
                {
                  "name": "BUCKET_NAME",
                  "value": "${azurerm_storage_account.blobs_storage.name}"
                },
                {
                  "name": "DATABASE_URL",
                  "secret_name": "doctor-database-url-url"
                },
                {
                  "name": "DB_HOST",
                  "value": "${azurerm_postgresql_flexible_server.main.fqdn}"
                },
                {
                  "name": "REDIS_URL",
                  "secret_name": "doctor-redis-url-url"
                },
                {
                  "name": "DB_URL",
                  "secret_name": "db-url"
                },
                {
                  "name": "CACHE_URL",
                  "secret_name": "cache-url"
                },
                {
                  "name": "BLOBS_URL",
                  "value": "${azurerm_storage_account.blobs_storage.primary_blob_endpoint}"
                }
              ],
              "image": "${azurerm_container_registry.main.login_server}/doctor@${docker_registry_image.doctor_push.sha256_digest}",
              "liveness_probe": [
                {
                  "path": "/",
                  "port": 80,
                  "transport": "HTTP"
                }
              ],
              "memory": "0.5Gi",
              "name": "doctor",
              "startup_probe": [
                {
                  "failure_count_threshold": 12,
                  "interval_seconds": 10,
                  "path": "/",
                  "port": 80,
                  "transport": "HTTP"
                }
              ]
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_container_app_environment": {
      "main": {
        "infrastructure_subnet_id": "${azurerm_subnet.infrastructure.id}",
        "internal_load_balancer_enabled": false,
        "location": "eastus",
        "log_analytics_workspace_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.OperationalInsights/workspaces/prod-logs",
        "name": "prod-doctor-env",
        "resource_group_name": "prod"
      }
    },
    "azurerm_container_registry": {
      "main": {
        "admin_enabled": true,
        "location": "eastus",
        "name": "prodacr",
        "resource_group_name": "prod",
        "sku": "Standard"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-doctor-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_key_vault_secret": {
      "cache_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-doctor-cache-password",
        "value": "${azurerm_managed_redis.cache_redis.default_database[0].primary_access_key}"
      },
      "db_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-doctor-db-password",
        "value": "${random_password.postgres_admin.result}"
      },
      "doctor_database_url_url": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-doctor-doctor-database-url",
        "value": "postgres://cloudcompose:${random_password.postgres_admin.result}@${azurerm_postgresql_flexible_server.main.fqdn}:5432/doctor_db"
      },
      "doctor_redis_url_url": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-doctor-doctor-redis-url",
        "value": "redis://${azurerm_managed_redis.cache_redis.hostname}:10000"
      }
    },
    "azurerm_managed_redis": {
      "cache_redis": {
        "default_database": [
          {
            "access_keys_authentication_enabled": true,
            "client_protocol": "Encrypted",
            "eviction_policy": "AllKeysLRU"
          }
        ],
        "high_availability_enabled": false,
        "location": "eastus",
        "name": "prod-doctor-cache",
        "public_network_access": "Disabled",
        "resource_group_name": "prod",
        "sku_name": "Balanced_B0"
      }
    },
    "azurerm_postgresql_flexible_server": {
      "main": {
        "administrator_login": "cloudcompose",
        "administrator_password": "${random_password.postgres_admin.result}",
        "backup_retention_days": 7,
        "delegated_subnet_id": "${azurerm_subnet.postgresql.id}",
        "depends_on": [
          "azurerm_private_dns_zone_virtual_network_link.postgresql"
        ],
        "lifecycle": {
          "ignore_changes": [
            "zone"
          ]
        },
        "location": "eastus",
        "name": "prod-doctor-pg",
        "private_dns_zone_id": "${azurerm_private_dns_zone.postgresql.id}",
        "public_network_access_enabled": false,
        "resource_group_name": "prod",
        "sku_name": "B_Standard_B1ms",
        "storage_mb": 32768,
        "version": "14"
      }
    },
    "azurerm_postgresql_flexible_server_database": {
      "db_db": {
        "charset": "UTF8",
        "collation": "en_US.utf8",
        "name": "doctor_db",
        "server_id": "${azurerm_postgresql_flexible_server.main.id}"
      }
    },
    "azurerm_private_dns_zone": {
      "postgresql": {
        "name": "doctor-postgresql.postgres.database.azure.com",
        "resource_group_name": "prod"
      },
      "redis": {
        "name": "privatelink.redis.azure.net",
        "resource_group_name": "prod"
      }
    },
    "azurerm_private_dns_zone_virtual_network_link": {
      "postgresql": {
        "name": "doctor-postgresql-link",
        "private_dns_zone_name": "${azurerm_private_dns_zone.postgresql.name}",
        "registration_enabled": false,
        "resource_group_name": "prod",
        "virtual_network_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet"
      },
      "redis": {
        "name": "doctor-redis-link",
        "private_dns_zone_name": "${azurerm_private_dns_zone.redis.name}",
        "registration_enabled": false,
        "resource_group_name": "prod",
        "virtual_network_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet"
      }
    },
    "azurerm_private_endpoint": {
      "cache_redis_pe": {
        "location": "eastus",
        "name": "prod-doctor-cache-redis-pe",
        "private_dns_zone_group": {
          "name": "default",
          "private_dns_zone_ids": [
            "${azurerm_private_dns_zone.redis.id}"
          ]
        },
        "private_service_connection": [
          {
            "is_manual_connection": false,
            "name": "prod-doctor-cache-redis-psc",
            "private_connection_resource_id": "${azurerm_managed_redis.cache_redis.id}",
            "subresource_names": [
              "redisEnterprise"
            ]
          }
        ],
        "resource_group_name": "prod",
        "subnet_id": "${azurerm_subnet.redis.id}"
      }
    },
    "azurerm_role_assignment": {
      "blobs_storage_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Storage Blob Data Contributor",
        "scope": "${azurerm_storage_account.blobs_storage.id}"
      },
      "kv_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Key Vault Secrets User",
        "scope": "${azurerm_key_vault.main.id}"
      }
    },
    "azurerm_storage_account": {
      "blobs_storage": {
        "account_kind": "StorageV2",
        "account_replication_type": "LRS",
        "account_tier": "Standard",
        "https_traffic_only_enabled": true,
        "location": "eastus",
        "min_tls_version": "TLS1_2",
        "name": "proddoctorblobs",
        "resource_group_name": "prod"
      }
    },
    "azurerm_storage_container": {
      "blobs_container": {
        "container_access_type": "private",
        "name": "blobs",
        "storage_account_name": "${azurerm_storage_account.blobs_storage.name}"
      }
    },
    "azurerm_subnet": {
      "infrastructure": {
        "address_prefixes": [
          "10.0.128.0/26"
        ],
        "delegation": [
          {
            "name": "container-apps",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.App/environments"
              }
            ]
          }
        ],
        "name": "prod-doctor-infrastructure",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "mysql": {
        "address_prefixes": [
          "10.0.128.128/26"
        ],
        "delegation": [
          {
            "name": "mysql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforMySQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-doctor-mysql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "postgresql": {
        "address_prefixes": [
          "10.0.128.64/26"
        ],
        "delegation": [
          {
            "name": "postgresql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforPostgreSQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-doctor-postgresql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "redis": {
        "address_prefixes": [
          "10.0.128.192/26"
        ],
        "name": "prod-doctor-redis",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-doctor-identity",
        "resource_group_name": "prod"
      }
    },
    "docker_image": {
      "doctor_image": {
        "build": {
          "context": "app",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${azurerm_container_registry.main.login_server}/doctor:latest"
      }
    },
    "docker_registry_image": {
      "doctor_push": {
        "keep_remotely": true,
        "name": "${docker_image.doctor_image.name}"
      }
    },
    "random_password": {
      "postgres_admin": {
        "length": 20,
        "special": false
      }
    },
    "time_sleep": {
      "kv_role_propagation": {
        "create_duration": "90s",
        "depends_on": [
          "azurerm_role_assignment.kv_role"
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      },
      "time": {
        "source": "hashicorp/time",
        "version": "~> 0.13"
      }
    }
  }
}