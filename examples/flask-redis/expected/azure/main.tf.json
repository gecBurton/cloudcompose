{
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 3.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "docker": {},
    "random": {}
  },
  "data": {
    "azurerm_client_config": {
      "current": {}
    },
    "azurerm_container_app_environment": {
      "main": {
        "name": "prod-env",
        "resource_group_name": "prod"
      }
    }
  },
  "resource": {
    "azurerm_container_app": {
      "web": {
        "name": "prod-flask-redis-web",
        "resource_group_name": "prod",
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "revision_mode": "Single",
        "template": {
          "container": [
            {
              "name": "web",
              "image": "flask-redis-web:latest",
              "cpu": 0.25,
              "memory": "0.5Gi",
              "env": [
                {
                  "name": "REDIS_HOST",
                  "value": "redis"
                },
                {
                  "name": "REDIS_URL",
                  "value": "postgresql://None:${azurerm_redis_cache.redis_redis.primary_access_key}@${azurerm_redis_cache.redis_redis.hostname}:6379/None"
                }
              ]
            }
          ],
          "min_replicas": 1,
          "max_replicas": 1,
          "http_scale_rule": [
            {
              "name": "http-default",
              "concurrent_requests": "100"
            }
          ]
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 8000,
          "transport": "auto",
          "traffic_weight": {
            "latest_revision": true,
            "percentage": 100
          }
        },
        "identity": {
          "type": "SystemAssigned"
        }
      }
    },
    "azurerm_key_vault": {
      "main": {
        "name": "prod-flask-redis-kv",
        "resource_group_name": "prod",
        "location": "eastus",
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "purge_protection_enabled": false
      }
    },
    "azurerm_redis_cache": {
      "redis_redis": {
        "name": "prod-flask-redis-redis",
        "resource_group_name": "prod",
        "location": "eastus",
        "sku_name": "Standard",
        "family": "C",
        "capacity": 1,
        "redis_version": "6",
        "enable_non_ssl_port": false,
        "minimum_tls_version": "1.2"
      }
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    }
  }
}