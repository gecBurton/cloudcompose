{
  "data": {
    "azurerm_client_config": {
      "current": {}
    },
    "azurerm_container_app_environment": {
      "main": {
        "name": "prod-env",
        "resource_group_name": "prod"
      }
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "random": {}
  },
  "resource": {
    "azurerm_container_app": {
      "web": {
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 8000,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-flask-redis-web",
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.redis_secret.versionless_id}",
            "name": "redis-url"
          }
        ],
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [
                {
                  "name": "REDIS_HOST",
                  "value": "${azurerm_managed_redis.redis_redis.hostname}"
                },
                {
                  "name": "REDIS_URL",
                  "secret_name": "redis-url"
                }
              ],
              "image": "flask-redis-web:latest",
              "liveness_probe": [
                {
                  "path": "/",
                  "port": 8000,
                  "transport": "HTTP"
                }
              ],
              "memory": "0.5Gi",
              "name": "web"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-flask-redis-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_key_vault_secret": {
      "redis_secret": {
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-flask-redis-redis-password",
        "value": "${azurerm_managed_redis.redis_redis.default_database[0].primary_access_key}"
      }
    },
    "azurerm_managed_redis": {
      "redis_redis": {
        "default_database": [
          {
            "access_keys_authentication_enabled": true,
            "client_protocol": "Encrypted",
            "eviction_policy": "AllKeysLRU"
          }
        ],
        "high_availability_enabled": false,
        "location": "eastus",
        "name": "prod-flask-redis-redis",
        "resource_group_name": "prod",
        "sku_name": "Balanced_B0"
      }
    },
    "azurerm_role_assignment": {
      "kv_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Key Vault Secrets User",
        "scope": "${azurerm_key_vault.main.id}"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-flask-redis-identity",
        "resource_group_name": "prod"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}