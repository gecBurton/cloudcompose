{
  "data": {
    "aws_ecr_authorization_token": {
      "token": {}
    }
  },
  "provider": {
    "aws": {
      "region": "us-east-1"
    },
    "docker": {
      "registry_auth": {
        "address": "${data.aws_ecr_authorization_token.token.proxy_endpoint}",
        "password": "${data.aws_ecr_authorization_token.token.password}",
        "username": "${data.aws_ecr_authorization_token.token.user_name}"
      }
    }
  },
  "resource": {
    "aws_cloudwatch_log_group": {
      "backend_lg": {
        "name": "/ecs/prod-flask-backend",
        "retention_in_days": 7
      },
      "frontend_lg": {
        "name": "/ecs/prod-flask-frontend",
        "retention_in_days": 7
      }
    },
    "aws_db_instance": {
      "db_db": {
        "allocated_storage": 20,
        "backup_retention_period": 7,
        "db_name": "example",
        "db_subnet_group_name": "${aws_db_subnet_group.db_sng.name}",
        "engine": "mariadb",
        "final_snapshot_identifier": "prod-flask-db-final-${random_id.db_snapshot.hex}",
        "identifier": "prod-flask-db",
        "instance_class": "db.t3.micro",
        "multi_az": false,
        "password": "${random_password.db_password.result}",
        "publicly_accessible": false,
        "skip_final_snapshot": false,
        "username": "cloudcompose",
        "vpc_security_group_ids": [
          "${aws_security_group.private_sg.id}"
        ]
      }
    },
    "aws_db_subnet_group": {
      "db_sng": {
        "name": "prod-flask-db-sng",
        "subnet_ids": [
          "subnet-3",
          "subnet-4"
        ]
      }
    },
    "aws_ecr_repository": {
      "backend_ecr": {
        "force_delete": false,
        "image_tag_mutability": "MUTABLE",
        "name": "prod-flask-backend"
      },
      "frontend_ecr": {
        "force_delete": false,
        "image_tag_mutability": "MUTABLE",
        "name": "prod-flask-frontend"
      }
    },
    "aws_ecs_service": {
      "backend_service": {
        "cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/prod-cluster",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "load_balancer": [
          {
            "container_name": "backend",
            "container_port": 80,
            "target_group_arn": "${aws_lb_target_group.backend_tg.arn}"
          }
        ],
        "name": "prod-flask-backend",
        "network_configuration": {
          "assign_public_ip": false,
          "security_groups": [
            "${aws_security_group.private_sg.id}",
            "${aws_security_group.public_sg.id}",
            "${aws_security_group.backend_ingress_sg.id}"
          ],
          "subnets": [
            "subnet-3",
            "subnet-4"
          ]
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.backend_discovery.arn}"
        },
        "task_definition": "${aws_ecs_task_definition.backend_td.arn}"
      },
      "frontend_service": {
        "cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/prod-cluster",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "load_balancer": [],
        "name": "prod-flask-frontend",
        "network_configuration": {
          "assign_public_ip": false,
          "security_groups": [
            "${aws_security_group.public_sg.id}"
          ],
          "subnets": [
            "subnet-3",
            "subnet-4"
          ]
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.frontend_discovery.arn}"
        },
        "task_definition": "${aws_ecs_task_definition.frontend_td.arn}"
      }
    },
    "aws_ecs_task_definition": {
      "backend_td": {
        "container_definitions": "[{\"name\": \"backend\", \"image\": \"${aws_ecr_repository.backend_ecr.repository_url}@${docker_registry_image.backend_push.sha256_digest}\", \"essential\": true, \"command\": [\"npm\", \"run\", \"start-watch\"], \"portMappings\": [{\"containerPort\": 80, \"hostPort\": 80, \"protocol\": \"tcp\"}], \"environment\": [{\"name\": \"DATABASE_DB\", \"value\": \"example\"}, {\"name\": \"DATABASE_HOST\", \"value\": \"${aws_db_instance.db_db.address}\"}, {\"name\": \"DATABASE_PASSWORD\", \"value\": \"/run/secrets/db-password\"}, {\"name\": \"DATABASE_USER\", \"value\": \"root\"}, {\"name\": \"NODE_ENV\", \"value\": \"development\"}], \"secrets\": [{\"name\": \"DB_PASSWORD\", \"valueFrom\": \"${aws_secretsmanager_secret.backend_db-password_secret.arn}\"}, {\"name\": \"DB_PASSWORD\", \"valueFrom\": \"${aws_secretsmanager_secret.db_db_secret.arn}:password::\"}, {\"name\": \"DB_USERNAME\", \"valueFrom\": \"${aws_secretsmanager_secret.db_db_secret.arn}:username::\"}], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.backend_lg.name}\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"ecs\"}}}]",
        "cpu": "256",
        "execution_role_arn": "${aws_iam_role.backend_exec_role.arn}",
        "family": "prod-flask-backend",
        "memory": "512",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "task_role_arn": "${aws_iam_role.backend_task_role.arn}"
      },
      "frontend_td": {
        "container_definitions": "[{\"name\": \"frontend\", \"image\": \"${aws_ecr_repository.frontend_ecr.repository_url}@${docker_registry_image.frontend_push.sha256_digest}\", \"essential\": true, \"portMappings\": [{\"containerPort\": 3000, \"hostPort\": 3000, \"protocol\": \"tcp\"}], \"environment\": [], \"secrets\": [], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.frontend_lg.name}\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"ecs\"}}}]",
        "cpu": "256",
        "execution_role_arn": "${aws_iam_role.frontend_exec_role.arn}",
        "family": "prod-flask-frontend",
        "memory": "512",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "task_role_arn": "${aws_iam_role.frontend_task_role.arn}"
      }
    },
    "aws_iam_role": {
      "backend_exec_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-flask-backend-exec-role"
      },
      "backend_task_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-flask-backend-task-role"
      },
      "frontend_exec_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-flask-frontend-exec-role"
      },
      "frontend_task_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-flask-frontend-task-role"
      }
    },
    "aws_iam_role_policy": {
      "backend_db-password_policy": {
        "name": "prod-flask-backend-db-password-policy",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"secretsmanager:GetSecretValue\"], \"Resource\": [\"${aws_secretsmanager_secret.backend_db-password_secret.arn}\"]}]}",
        "role": "${aws_iam_role.backend_exec_role.name}"
      },
      "backend_exec_ecr_policy": {
        "name": "prod-flask-backend-exec-ecr-policy",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"ecr:GetAuthorizationToken\", \"ecr:BatchCheckLayerAvailability\", \"ecr:GetDownloadUrlForLayer\", \"ecr:BatchGetImage\"], \"Resource\": \"*\"}]}",
        "role": "${aws_iam_role.backend_exec_role.name}"
      },
      "backend_exec_log_policy": {
        "name": "prod-flask-backend-exec-log-policy",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": [\"${aws_cloudwatch_log_group.backend_lg.arn}:*\"]}]}",
        "role": "${aws_iam_role.backend_exec_role.name}"
      },
      "backend_to_db_rds_secret": {
        "name": "prod-flask-backend-db-rds-secret",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"secretsmanager:GetSecretValue\"], \"Resource\": [\"${aws_secretsmanager_secret.db_db_secret.arn}\"]}]}",
        "role": "${aws_iam_role.backend_exec_role.name}"
      },
      "frontend_exec_ecr_policy": {
        "name": "prod-flask-frontend-exec-ecr-policy",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"ecr:GetAuthorizationToken\", \"ecr:BatchCheckLayerAvailability\", \"ecr:GetDownloadUrlForLayer\", \"ecr:BatchGetImage\"], \"Resource\": \"*\"}]}",
        "role": "${aws_iam_role.frontend_exec_role.name}"
      },
      "frontend_exec_log_policy": {
        "name": "prod-flask-frontend-exec-log-policy",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": [\"${aws_cloudwatch_log_group.frontend_lg.arn}:*\"]}]}",
        "role": "${aws_iam_role.frontend_exec_role.name}"
      }
    },
    "aws_lb_listener_rule": {
      "backend_listener_rule": {
        "action": [
          {
            "target_group_arn": "${aws_lb_target_group.backend_tg.arn}",
            "type": "forward"
          }
        ],
        "condition": [
          {
            "path_pattern": {
              "values": [
                "/*"
              ]
            }
          }
        ],
        "listener_arn": "arn:aws:lb:us-east-1:123456789012:listener/app/shared-alb/123/456",
        "priority": 41501
      }
    },
    "aws_lb_target_group": {
      "backend_tg": {
        "health_check": {
          "enabled": true,
          "matcher": "200-399",
          "path": "/"
        },
        "name": "prod-flask-backend-tg",
        "port": 80,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "vpc-123"
      }
    },
    "aws_secretsmanager_secret": {
      "backend_db-password_secret": {
        "description": "Secret db-password for flask service backend",
        "name": "prod-flask-backend-db-password",
        "recovery_window_in_days": 0
      },
      "db_db_secret": {
        "description": "Credentials for db RDS",
        "name": "prod-flask-db-credentials",
        "recovery_window_in_days": 0
      }
    },
    "aws_secretsmanager_secret_version": {
      "backend_db-password_secret_v1": {
        "lifecycle": {
          "ignore_changes": [
            "secret_string"
          ]
        },
        "secret_id": "${aws_secretsmanager_secret.backend_db-password_secret.id}",
        "secret_string": "PLACEHOLDER_VALUE_CHANGE_IN_AWS_CONSOLE"
      },
      "db_db_secret_v1": {
        "secret_id": "${aws_secretsmanager_secret.db_db_secret.id}",
        "secret_string": "{\"username\": \"cloudcompose\", \"password\": \"${random_password.db_password.result}\", \"engine\": \"mariadb\"}"
      }
    },
    "aws_security_group": {
      "backend_ingress_sg": {
        "description": "Load balancer ingress to backend",
        "name": "prod-flask-backend-ingress",
        "vpc_id": "vpc-123"
      },
      "private_sg": {
        "description": "Network private of flask in prod",
        "name": "prod-flask-private",
        "vpc_id": "vpc-123"
      },
      "public_sg": {
        "description": "Network public of flask in prod",
        "name": "prod-flask-public",
        "vpc_id": "vpc-123"
      }
    },
    "aws_security_group_rule": {
      "alb_to_backend_rule": {
        "description": "Allow the load balancer to reach backend",
        "from_port": 80,
        "protocol": "tcp",
        "security_group_id": "${aws_security_group.backend_ingress_sg.id}",
        "source_security_group_id": "sg-alb0123456789",
        "to_port": 80,
        "type": "ingress"
      },
      "private_sg_egress_rule": {
        "cidr_blocks": [
          "0.0.0.0/0"
        ],
        "description": "Allow all outbound from network private",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.private_sg.id}",
        "to_port": 0,
        "type": "egress"
      },
      "private_sg_internal_rule": {
        "description": "Allow traffic within network private",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.private_sg.id}",
        "source_security_group_id": "${aws_security_group.private_sg.id}",
        "to_port": 0,
        "type": "ingress"
      },
      "public_sg_egress_rule": {
        "cidr_blocks": [
          "0.0.0.0/0"
        ],
        "description": "Allow all outbound from network public",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.public_sg.id}",
        "to_port": 0,
        "type": "egress"
      },
      "public_sg_internal_rule": {
        "description": "Allow traffic within network public",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.public_sg.id}",
        "source_security_group_id": "${aws_security_group.public_sg.id}",
        "to_port": 0,
        "type": "ingress"
      }
    },
    "aws_service_discovery_private_dns_namespace": {
      "app": {
        "description": "Service discovery for flask in prod",
        "name": "prod-flask.internal",
        "vpc": "vpc-123"
      }
    },
    "aws_service_discovery_service": {
      "backend_discovery": {
        "dns_config": {
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ],
          "namespace_id": "${aws_service_discovery_private_dns_namespace.app.id}",
          "routing_policy": "MULTIVALUE"
        },
        "health_check_custom_config": {
          "failure_threshold": 1
        },
        "name": "backend"
      },
      "frontend_discovery": {
        "dns_config": {
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ],
          "namespace_id": "${aws_service_discovery_private_dns_namespace.app.id}",
          "routing_policy": "MULTIVALUE"
        },
        "health_check_custom_config": {
          "failure_threshold": 1
        },
        "name": "frontend"
      }
    },
    "docker_image": {
      "backend_image": {
        "build": {
          "context": "backend",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${aws_ecr_repository.backend_ecr.repository_url}:latest"
      },
      "frontend_image": {
        "build": {
          "context": "frontend",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${aws_ecr_repository.frontend_ecr.repository_url}:latest"
      }
    },
    "docker_registry_image": {
      "backend_push": {
        "keep_remotely": true,
        "name": "${docker_image.backend_image.name}"
      },
      "frontend_push": {
        "keep_remotely": true,
        "name": "${docker_image.frontend_image.name}"
      }
    },
    "random_id": {
      "db_snapshot": {
        "byte_length": 4
      }
    },
    "random_password": {
      "db_password": {
        "length": 20,
        "special": false
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}