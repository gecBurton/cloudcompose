{
  "data": {
    "azurerm_client_config": {
      "current": {}
    },
    "azurerm_container_app_environment": {
      "main": {
        "name": "prod-env",
        "resource_group_name": "prod"
      }
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.backend.ingress[0].fqdn}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "docker": {
      "registry_auth": [
        {
          "address": "${azurerm_container_registry.main.login_server}",
          "password": "${azurerm_container_registry.main.admin_password}",
          "username": "${azurerm_container_registry.main.admin_username}"
        }
      ]
    },
    "random": {}
  },
  "resource": {
    "azurerm_container_app": {
      "backend": {
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-flask-backend",
        "registry": [
          {
            "password_secret_name": "acr-password",
            "server": "${azurerm_container_registry.main.login_server}",
            "username": "${azurerm_container_registry.main.admin_username}"
          }
        ],
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "name": "acr-password",
            "value": "${azurerm_container_registry.main.admin_password}"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.db_secret.versionless_id}",
            "name": "db-url"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.backend_db-password_secret.versionless_id}",
            "name": "backend-db-password"
          }
        ],
        "template": {
          "container": [
            {
              "args": [
                "npm",
                "run",
                "start-watch"
              ],
              "cpu": 0.25,
              "env": [
                {
                  "name": "DATABASE_DB",
                  "value": "example"
                },
                {
                  "name": "DATABASE_HOST",
                  "value": "db"
                },
                {
                  "name": "DATABASE_PASSWORD",
                  "value": "/run/secrets/db-password"
                },
                {
                  "name": "DATABASE_USER",
                  "value": "root"
                },
                {
                  "name": "NODE_ENV",
                  "value": "development"
                },
                {
                  "name": "DB_URL",
                  "secret_name": "db-url"
                },
                {
                  "name": "DB_PASSWORD",
                  "secret_name": "backend-db-password"
                }
              ],
              "image": "${azurerm_container_registry.main.login_server}/backend@${docker_registry_image.backend_push.sha256_digest}",
              "memory": "0.5Gi",
              "name": "backend"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      },
      "frontend": {
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "identity": {
          "type": "SystemAssigned"
        },
        "name": "prod-flask-frontend",
        "registry": [
          {
            "password_secret_name": "acr-password",
            "server": "${azurerm_container_registry.main.login_server}",
            "username": "${azurerm_container_registry.main.admin_username}"
          }
        ],
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "name": "acr-password",
            "value": "${azurerm_container_registry.main.admin_password}"
          }
        ],
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [],
              "image": "${azurerm_container_registry.main.login_server}/frontend@${docker_registry_image.frontend_push.sha256_digest}",
              "memory": "0.5Gi",
              "name": "frontend"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_container_registry": {
      "main": {
        "admin_enabled": true,
        "location": "eastus",
        "name": "prodacr",
        "resource_group_name": "prod",
        "sku": "Standard"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-flask-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_key_vault_secret": {
      "backend_db-password_secret": {
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-flask-backend-db-password",
        "value": "PLACEHOLDER_VALUE_CHANGE_IN_AZURE_PORTAL"
      },
      "db_secret": {
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-flask-db-password",
        "value": "${random_password.mysql_admin.result}"
      }
    },
    "azurerm_mysql_flexible_database": {
      "db_db": {
        "charset": "utf8mb4",
        "collation": "utf8mb4_unicode_ci",
        "name": "example",
        "resource_group_name": "prod",
        "server_name": "${azurerm_mysql_flexible_server.main.name}"
      }
    },
    "azurerm_mysql_flexible_server": {
      "main": {
        "administrator_login": "cloudcompose",
        "administrator_password": "${random_password.mysql_admin.result}",
        "backup_retention_days": 7,
        "location": "eastus",
        "name": "prod-flask-mysql",
        "public_network_access": "Enabled",
        "resource_group_name": "prod",
        "sku_name": "B_Standard_B1ms",
        "storage": [
          {
            "size_gb": 32
          }
        ],
        "version": "8.0.21"
      }
    },
    "azurerm_role_assignment": {
      "kv_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Key Vault Secrets User",
        "scope": "${azurerm_key_vault.main.id}"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-flask-identity",
        "resource_group_name": "prod"
      }
    },
    "docker_image": {
      "backend_image": {
        "build": {
          "context": "backend",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${azurerm_container_registry.main.login_server}/backend:latest"
      },
      "frontend_image": {
        "build": {
          "context": "frontend",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${azurerm_container_registry.main.login_server}/frontend:latest"
      }
    },
    "docker_registry_image": {
      "backend_push": {
        "keep_remotely": true,
        "name": "${docker_image.backend_image.name}"
      },
      "frontend_push": {
        "keep_remotely": true,
        "name": "${docker_image.frontend_image.name}"
      }
    },
    "random_password": {
      "mysql_admin": {
        "length": 20,
        "special": false
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}
