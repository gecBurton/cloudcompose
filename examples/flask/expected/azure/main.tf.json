{
  "data": {
    "azurerm_client_config": {
      "current": {}
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.backend.ingress[0].fqdn}"
    },
    "key_vault_name": {
      "description": "Name of the Key Vault holding managed-service/secrets/config credentials, if any.",
      "value": "${azurerm_key_vault.main.name}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "docker": {
      "registry_auth": [
        {
          "address": "${azurerm_container_registry.main.login_server}",
          "password": "${azurerm_container_registry.main.admin_password}",
          "username": "${azurerm_container_registry.main.admin_username}"
        }
      ]
    },
    "random": {},
    "time": {}
  },
  "resource": {
    "azurerm_container_app": {
      "backend": {
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-flask-backend",
        "registry": [
          {
            "password_secret_name": "acr-password",
            "server": "${azurerm_container_registry.main.login_server}",
            "username": "${azurerm_container_registry.main.admin_username}"
          }
        ],
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "name": "acr-password",
            "value": "${azurerm_container_registry.main.admin_password}"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.db_secret.versionless_id}",
            "name": "db-url"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.backend_db-password_secret.versionless_id}",
            "name": "backend-db-password"
          }
        ],
        "template": {
          "container": [
            {
              "args": [
                "npm",
                "run",
                "start-watch"
              ],
              "cpu": 0.25,
              "env": [
                {
                  "name": "DATABASE_DB",
                  "value": "example"
                },
                {
                  "name": "DATABASE_HOST",
                  "value": "${azurerm_mysql_flexible_server.main.fqdn}"
                },
                {
                  "name": "DATABASE_PASSWORD",
                  "value": "/run/secrets/db-password"
                },
                {
                  "name": "DATABASE_USER",
                  "value": "root"
                },
                {
                  "name": "NODE_ENV",
                  "value": "development"
                },
                {
                  "name": "DB_URL",
                  "secret_name": "db-url"
                },
                {
                  "name": "DB_PASSWORD",
                  "secret_name": "backend-db-password"
                }
              ],
              "image": "${azurerm_container_registry.main.login_server}/backend@${docker_registry_image.backend_push.sha256_digest}",
              "liveness_probe": [
                {
                  "path": "/",
                  "port": 80,
                  "transport": "HTTP"
                }
              ],
              "memory": "0.5Gi",
              "name": "backend"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      },
      "frontend": {
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "identity": {
          "type": "SystemAssigned"
        },
        "name": "prod-flask-frontend",
        "registry": [
          {
            "password_secret_name": "acr-password",
            "server": "${azurerm_container_registry.main.login_server}",
            "username": "${azurerm_container_registry.main.admin_username}"
          }
        ],
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "name": "acr-password",
            "value": "${azurerm_container_registry.main.admin_password}"
          }
        ],
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [],
              "image": "${azurerm_container_registry.main.login_server}/frontend@${docker_registry_image.frontend_push.sha256_digest}",
              "memory": "0.5Gi",
              "name": "frontend"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_container_app_environment": {
      "main": {
        "infrastructure_subnet_id": "${azurerm_subnet.infrastructure.id}",
        "internal_load_balancer_enabled": false,
        "location": "eastus",
        "log_analytics_workspace_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.OperationalInsights/workspaces/prod-logs",
        "name": "prod-flask-env",
        "resource_group_name": "prod"
      }
    },
    "azurerm_container_registry": {
      "main": {
        "admin_enabled": true,
        "location": "eastus",
        "name": "prodacr",
        "resource_group_name": "prod",
        "sku": "Standard"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-flask-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_key_vault_secret": {
      "backend_db-password_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-flask-backend-db-password",
        "value": "PLACEHOLDER_VALUE_CHANGE_IN_AZURE_PORTAL"
      },
      "db_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-flask-db-password",
        "value": "${random_password.mysql_admin.result}"
      }
    },
    "azurerm_mysql_flexible_database": {
      "db_db": {
        "charset": "utf8mb4",
        "collation": "utf8mb4_unicode_ci",
        "name": "example",
        "resource_group_name": "prod",
        "server_name": "${azurerm_mysql_flexible_server.main.name}"
      }
    },
    "azurerm_mysql_flexible_server": {
      "main": {
        "administrator_login": "cloudcompose",
        "administrator_password": "${random_password.mysql_admin.result}",
        "backup_retention_days": 7,
        "delegated_subnet_id": "${azurerm_subnet.mysql.id}",
        "depends_on": [
          "azurerm_private_dns_zone_virtual_network_link.mysql"
        ],
        "location": "eastus",
        "name": "prod-flask-mysql",
        "private_dns_zone_id": "${azurerm_private_dns_zone.mysql.id}",
        "resource_group_name": "prod",
        "sku_name": "B_Standard_B1ms",
        "storage": [
          {
            "size_gb": 32
          }
        ],
        "version": "8.0.21"
      }
    },
    "azurerm_private_dns_zone": {
      "mysql": {
        "name": "flask-mysql.mysql.database.azure.com",
        "resource_group_name": "prod"
      }
    },
    "azurerm_private_dns_zone_virtual_network_link": {
      "mysql": {
        "name": "flask-mysql-link",
        "private_dns_zone_name": "${azurerm_private_dns_zone.mysql.name}",
        "registration_enabled": false,
        "resource_group_name": "prod",
        "virtual_network_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet"
      }
    },
    "azurerm_role_assignment": {
      "kv_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Key Vault Secrets User",
        "scope": "${azurerm_key_vault.main.id}"
      }
    },
    "azurerm_subnet": {
      "infrastructure": {
        "address_prefixes": [
          "10.0.128.0/26"
        ],
        "delegation": [
          {
            "name": "container-apps",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.App/environments"
              }
            ]
          }
        ],
        "name": "prod-flask-infrastructure",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "mysql": {
        "address_prefixes": [
          "10.0.128.128/26"
        ],
        "delegation": [
          {
            "name": "mysql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforMySQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-flask-mysql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "postgresql": {
        "address_prefixes": [
          "10.0.128.64/26"
        ],
        "delegation": [
          {
            "name": "postgresql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforPostgreSQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-flask-postgresql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "redis": {
        "address_prefixes": [
          "10.0.128.192/26"
        ],
        "name": "prod-flask-redis",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-flask-identity",
        "resource_group_name": "prod"
      }
    },
    "docker_image": {
      "backend_image": {
        "build": {
          "context": "backend",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${azurerm_container_registry.main.login_server}/backend:latest"
      },
      "frontend_image": {
        "build": {
          "context": "frontend",
          "dockerfile": "Dockerfile",
          "platform": "linux/amd64"
        },
        "name": "${azurerm_container_registry.main.login_server}/frontend:latest"
      }
    },
    "docker_registry_image": {
      "backend_push": {
        "keep_remotely": true,
        "name": "${docker_image.backend_image.name}"
      },
      "frontend_push": {
        "keep_remotely": true,
        "name": "${docker_image.frontend_image.name}"
      }
    },
    "random_password": {
      "mysql_admin": {
        "length": 20,
        "special": false
      }
    },
    "time_sleep": {
      "kv_role_propagation": {
        "create_duration": "90s",
        "depends_on": [
          "azurerm_role_assignment.kv_role"
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      },
      "time": {
        "source": "hashicorp/time",
        "version": "~> 0.13"
      }
    }
  }
}