{
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 3.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "docker": {},
    "random": {}
  },
  "data": {
    "azurerm_client_config": {
      "current": {}
    }
  },
  "resource": {
    "azurerm_container_app_environment": {
      "main": {
        "name": "prod-env",
        "resource_group_name": "prod",
        "location": "eastus",
        "log_analytics_workspace_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.OperationalInsights/workspaces/prod-logs",
        "infrastructure_subnet_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet/subnets/infrastructure",
        "internal_load_balancer_enabled": false
      }
    },
    "azurerm_container_app": {
      "backend": {
        "name": "prod-flask-backend",
        "resource_group_name": "prod",
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "revision_mode": "Single",
        "template": {
          "container": [
            {
              "name": "backend",
              "image": "prodacr.azurecr.io/backend:latest",
              "cpu": 0.25,
              "memory": "0.5Gi",
              "args": [
                "npm",
                "run",
                "start-watch"
              ],
              "env": [
                {
                  "name": "DATABASE_DB",
                  "value": "example"
                },
                {
                  "name": "DATABASE_HOST",
                  "value": "db"
                },
                {
                  "name": "DATABASE_PASSWORD",
                  "value": "/run/secrets/db-password"
                },
                {
                  "name": "DATABASE_USER",
                  "value": "root"
                },
                {
                  "name": "NODE_ENV",
                  "value": "development"
                },
                {
                  "name": "DB_URL",
                  "value": "postgresql://composey:${random_password.postgres_admin.result}@${azurerm_postgresql_flexible_server.main.fqdn}:5432/example"
                }
              ]
            }
          ],
          "min_replicas": 1,
          "max_replicas": 1,
          "http_scale_rule": [
            {
              "name": "http-default",
              "concurrent_requests": "100"
            }
          ]
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "transport": "auto",
          "traffic_weight": {
            "latest_revision": true,
            "percentage": 100
          }
        },
        "identity": {
          "type": "SystemAssigned"
        },
        "registry": [
          {
            "server": "prodacr.azurecr.io",
            "identity": "${azurerm_container_app.main.identity[0].principal_id}"
          }
        ]
      },
      "frontend": {
        "name": "prod-flask-frontend",
        "resource_group_name": "prod",
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "revision_mode": "Single",
        "template": {
          "container": [
            {
              "name": "frontend",
              "image": "prodacr.azurecr.io/frontend:latest",
              "cpu": 0.25,
              "memory": "0.5Gi",
              "env": []
            }
          ],
          "min_replicas": 1,
          "max_replicas": 1
        },
        "identity": {
          "type": "SystemAssigned"
        },
        "registry": [
          {
            "server": "prodacr.azurecr.io",
            "identity": "${azurerm_container_app.main.identity[0].principal_id}"
          }
        ]
      }
    },
    "azurerm_container_registry": {
      "main": {
        "name": "prodacr",
        "resource_group_name": "prod",
        "location": "eastus",
        "sku": "Standard",
        "admin_enabled": true
      }
    },
    "azurerm_postgresql_flexible_server": {
      "main": {
        "name": "prod-flask-pg",
        "resource_group_name": "prod",
        "location": "eastus",
        "version": "14",
        "sku_name": "B_Standard_B1ms",
        "storage_mb": 32768,
        "administrator_login": "composey",
        "administrator_password": "${random_password.postgres_admin.result}",
        "delegated_subnet_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet/subnets/infrastructure",
        "public_network_access_enabled": false
      }
    },
    "azurerm_postgresql_flexible_server_database": {
      "db_db": {
        "name": "example",
        "server_id": "${azurerm_postgresql_flexible_server.main.id}",
        "charset": "UTF8",
        "collation": "en_US.utf8"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "name": "prod-flask-kv",
        "resource_group_name": "prod",
        "location": "eastus",
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "purge_protection_enabled": false
      }
    },
    "random_password": {
      "postgres_admin": {
        "length": 20,
        "special": false
      }
    }
  }
}