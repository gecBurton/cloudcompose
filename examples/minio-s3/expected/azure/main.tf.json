{
  "data": {
    "azurerm_client_config": {
      "current": {}
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    },
    "key_vault_name": {
      "description": "Name of the Key Vault holding managed-service/secrets/config credentials, if any.",
      "value": "${azurerm_key_vault.main.name}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "random": {}
  },
  "resource": {
    "azurerm_container_app": {
      "web": {
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-minio-s3-web",
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [
                {
                  "name": "BUCKET_NAME",
                  "value": "${azurerm_storage_account.blobs_storage.name}"
                },
                {
                  "name": "S3_ENDPOINT",
                  "value": "http://${azurerm_storage_account.blobs_storage.primary_blob_endpoint}"
                },
                {
                  "name": "BLOBS_URL",
                  "value": "${azurerm_storage_account.blobs_storage.primary_blob_endpoint}"
                }
              ],
              "image": "nginxdemos/hello:plain-text",
              "liveness_probe": [
                {
                  "path": "/",
                  "port": 80,
                  "transport": "HTTP"
                }
              ],
              "memory": "0.5Gi",
              "name": "web"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_container_app_environment": {
      "main": {
        "infrastructure_subnet_id": "${azurerm_subnet.infrastructure.id}",
        "internal_load_balancer_enabled": false,
        "location": "eastus",
        "log_analytics_workspace_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.OperationalInsights/workspaces/prod-logs",
        "name": "prod-minio-s3-env",
        "resource_group_name": "prod"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-minio-s3-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_role_assignment": {
      "blobs_storage_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Storage Blob Data Contributor",
        "scope": "${azurerm_storage_account.blobs_storage.id}"
      }
    },
    "azurerm_storage_account": {
      "blobs_storage": {
        "account_kind": "StorageV2",
        "account_replication_type": "LRS",
        "account_tier": "Standard",
        "https_traffic_only_enabled": true,
        "location": "eastus",
        "min_tls_version": "TLS1_2",
        "name": "prodminios3blobs",
        "resource_group_name": "prod"
      }
    },
    "azurerm_storage_container": {
      "blobs_container": {
        "container_access_type": "private",
        "name": "blobs",
        "storage_account_name": "${azurerm_storage_account.blobs_storage.name}"
      }
    },
    "azurerm_subnet": {
      "infrastructure": {
        "address_prefixes": [
          "10.0.128.0/26"
        ],
        "delegation": [
          {
            "name": "container-apps",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.App/environments"
              }
            ]
          }
        ],
        "name": "prod-minio-s3-infrastructure",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "mysql": {
        "address_prefixes": [
          "10.0.128.128/26"
        ],
        "delegation": [
          {
            "name": "mysql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforMySQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-minio-s3-mysql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "postgresql": {
        "address_prefixes": [
          "10.0.128.64/26"
        ],
        "delegation": [
          {
            "name": "postgresql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforPostgreSQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-minio-s3-postgresql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "redis": {
        "address_prefixes": [
          "10.0.128.192/26"
        ],
        "name": "prod-minio-s3-redis",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-minio-s3-identity",
        "resource_group_name": "prod"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}