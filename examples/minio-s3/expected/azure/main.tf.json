{
  "data": {
    "azurerm_client_config": {
      "current": {}
    },
    "azurerm_container_app_environment": {
      "main": {
        "name": "prod-env",
        "resource_group_name": "prod"
      }
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "random": {}
  },
  "resource": {
    "azurerm_container_app": {
      "web": {
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-minio-s3-web",
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [
                {
                  "name": "BUCKET_NAME",
                  "value": "blobs"
                },
                {
                  "name": "S3_ENDPOINT",
                  "value": "http://blobs:9000"
                },
                {
                  "name": "BLOBS_URL",
                  "value": "${azurerm_storage_account.blobs_storage.primary_blob_endpoint}"
                }
              ],
              "image": "nginxdemos/hello:plain-text",
              "memory": "0.5Gi",
              "name": "web"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-minio-s3-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_role_assignment": {
      "blobs_storage_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Storage Blob Data Contributor",
        "scope": "${azurerm_storage_account.blobs_storage.id}"
      }
    },
    "azurerm_storage_account": {
      "blobs_storage": {
        "account_kind": "StorageV2",
        "account_replication_type": "LRS",
        "account_tier": "Standard",
        "https_traffic_only_enabled": true,
        "location": "eastus",
        "min_tls_version": "TLS1_2",
        "name": "prodminios3blobs",
        "resource_group_name": "prod"
      }
    },
    "azurerm_storage_container": {
      "blobs_container": {
        "container_access_type": "private",
        "name": "blobs",
        "storage_account_name": "${azurerm_storage_account.blobs_storage.name}"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-minio-s3-identity",
        "resource_group_name": "prod"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}
