{
  "data": {
    "azurerm_client_config": {
      "current": {}
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    },
    "key_vault_name": {
      "description": "Name of the Key Vault holding managed-service/secrets/config credentials, if any.",
      "value": "${azurerm_key_vault.main.name}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "random": {},
    "time": {}
  },
  "resource": {
    "azurerm_container_app": {
      "web": {
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-platform-config-web",
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.web_config_api_token_secret.versionless_id}",
            "name": "web-config-api-token"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.web_config_sentry_dsn_secret.versionless_id}",
            "name": "web-config-sentry-dsn"
          }
        ],
        "template": {
          "container": [
            {
              "cpu": 0.25,
              "env": [
                {
                  "name": "LOG_LEVEL",
                  "value": "info"
                },
                {
                  "name": "API_TOKEN",
                  "secret_name": "web-config-api-token"
                },
                {
                  "name": "SENTRY_DSN",
                  "secret_name": "web-config-sentry-dsn"
                }
              ],
              "image": "nginxdemos/hello:plain-text",
              "liveness_probe": [
                {
                  "path": "/",
                  "port": 80,
                  "transport": "HTTP"
                }
              ],
              "memory": "0.5Gi",
              "name": "web"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 1,
          "min_replicas": 1
        }
      }
    },
    "azurerm_container_app_environment": {
      "main": {
        "infrastructure_subnet_id": "${azurerm_subnet.infrastructure.id}",
        "internal_load_balancer_enabled": false,
        "location": "eastus",
        "log_analytics_workspace_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.OperationalInsights/workspaces/prod-logs",
        "name": "prod-platform-config-env",
        "resource_group_name": "prod"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-platform-config-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_key_vault_secret": {
      "web_config_api_token_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-platform-config-web-config-api-token",
        "value": "PLACEHOLDER_VALUE_CHANGE_IN_AZURE_PORTAL"
      },
      "web_config_sentry_dsn_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-platform-config-web-config-sentry-dsn",
        "value": "PLACEHOLDER_VALUE_CHANGE_IN_AZURE_PORTAL"
      }
    },
    "azurerm_role_assignment": {
      "kv_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Key Vault Secrets User",
        "scope": "${azurerm_key_vault.main.id}"
      }
    },
    "azurerm_subnet": {
      "infrastructure": {
        "address_prefixes": [
          "10.0.128.0/26"
        ],
        "delegation": [
          {
            "name": "container-apps",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.App/environments"
              }
            ]
          }
        ],
        "name": "prod-platform-config-infrastructure",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "mysql": {
        "address_prefixes": [
          "10.0.128.128/26"
        ],
        "delegation": [
          {
            "name": "mysql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforMySQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-platform-config-mysql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "postgresql": {
        "address_prefixes": [
          "10.0.128.64/26"
        ],
        "delegation": [
          {
            "name": "postgresql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforPostgreSQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-platform-config-postgresql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "redis": {
        "address_prefixes": [
          "10.0.128.192/26"
        ],
        "name": "prod-platform-config-redis",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-platform-config-identity",
        "resource_group_name": "prod"
      }
    },
    "time_sleep": {
      "kv_role_propagation": {
        "create_duration": "90s",
        "depends_on": [
          "azurerm_role_assignment.kv_role"
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      },
      "time": {
        "source": "hashicorp/time",
        "version": "~> 0.13"
      }
    }
  }
}