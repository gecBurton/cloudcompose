{
  "data": {
    "aws_lb": {
      "shared_alb": {
        "arn": "arn:aws:lb:us-east-1:123456789012:loadbalancer/app/shared-alb/123"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "us-east-1"
      },
      {
        "alias": "us_east_1",
        "region": "us-east-1"
      }
    ]
  },
  "resource": {
    "aws_appautoscaling_policy": {
      "web_scaling_0": {
        "name": "prod-production-stack-web-scaling-cpu",
        "policy_type": "TargetTrackingScaling",
        "resource_id": "${aws_appautoscaling_target.web_asg_target.resource_id}",
        "scalable_dimension": "ecs:service:DesiredCount",
        "service_namespace": "ecs",
        "target_tracking_scaling_policy_configuration": {
          "predefined_metric_specification": {
            "predefined_metric_type": "ECSServiceAverageCPUUtilization"
          },
          "scale_in_cooldown": 300,
          "scale_out_cooldown": 60,
          "target_value": 70
        }
      },
      "web_scaling_1": {
        "name": "prod-production-stack-web-scaling-memory",
        "policy_type": "TargetTrackingScaling",
        "resource_id": "${aws_appautoscaling_target.web_asg_target.resource_id}",
        "scalable_dimension": "ecs:service:DesiredCount",
        "service_namespace": "ecs",
        "target_tracking_scaling_policy_configuration": {
          "predefined_metric_specification": {
            "predefined_metric_type": "ECSServiceAverageMemoryUtilization"
          },
          "scale_in_cooldown": 300,
          "scale_out_cooldown": 60,
          "target_value": 80
        }
      }
    },
    "aws_appautoscaling_target": {
      "web_asg_target": {
        "max_capacity": 10,
        "min_capacity": 2,
        "resource_id": "service/${split(\"/\", \"${aws_ecs_service.web_service.cluster}\")[1]}/${aws_ecs_service.web_service.name}",
        "scalable_dimension": "ecs:service:DesiredCount",
        "service_namespace": "ecs"
      }
    },
    "aws_cloudfront_distribution": {
      "web_cdn": {
        "comment": "CDN for web",
        "default_cache_behavior": {
          "allowed_methods": [
            "DELETE",
            "GET",
            "HEAD",
            "OPTIONS",
            "PATCH",
            "POST",
            "PUT"
          ],
          "cached_methods": [
            "GET",
            "HEAD"
          ],
          "forwarded_values": {
            "cookies": {
              "forward": "all"
            },
            "query_string": true
          },
          "target_origin_id": "ALB",
          "viewer_protocol_policy": "redirect-to-https"
        },
        "enabled": true,
        "origin": [
          {
            "custom_origin_config": {
              "http_port": 80,
              "https_port": 443,
              "origin_protocol_policy": "http-only",
              "origin_ssl_protocols": [
                "TLSv1.2"
              ]
            },
            "domain_name": "${data.aws_lb.shared_alb.dns_name}",
            "origin_id": "ALB"
          }
        ],
        "restrictions": {
          "geo_restriction": {
            "restriction_type": "none"
          }
        },
        "viewer_certificate": {
          "cloudfront_default_certificate": true
        },
        "web_acl_id": "${aws_wafv2_web_acl.web_waf.arn}"
      }
    },
    "aws_cloudwatch_event_rule": {
      "cleanup_rule": {
        "description": "Schedule for cleanup",
        "name": "prod-production-stack-cleanup-rule",
        "schedule_expression": "cron(0 2 * * ? *)",
        "state": "ENABLED"
      }
    },
    "aws_cloudwatch_event_target": {
      "cleanup_target": {
        "arn": "arn:aws:ecs:us-east-1:123456789012:cluster/prod-cluster",
        "ecs_target": {
          "launch_type": "FARGATE",
          "network_configuration": {
            "assign_public_ip": false,
            "security_groups": [
              "${aws_security_group.default_sg.id}"
            ],
            "subnets": [
              "subnet-3",
              "subnet-4"
            ]
          },
          "task_count": 1,
          "task_definition_arn": "${aws_ecs_task_definition.cleanup_td.arn}"
        },
        "role_arn": "${aws_iam_role.cleanup_eb_role.arn}",
        "rule": "${aws_cloudwatch_event_rule.cleanup_rule.name}"
      }
    },
    "aws_cloudwatch_log_group": {
      "cleanup_lg": {
        "name": "/ecs/prod-production-stack-cleanup",
        "retention_in_days": 7
      },
      "web_lg": {
        "name": "/ecs/prod-production-stack-web",
        "retention_in_days": 7
      }
    },
    "aws_db_instance": {
      "db_db": {
        "allocated_storage": 20,
        "backup_retention_period": 7,
        "db_name": "production_stack_db",
        "db_subnet_group_name": "${aws_db_subnet_group.db_sng.name}",
        "enabled_cloudwatch_logs_exports": [
          "postgresql",
          "upgrade"
        ],
        "engine": "postgres",
        "final_snapshot_identifier": "prod-production-stack-db-final-${random_id.db_snapshot.hex}",
        "identifier": "prod-production-stack-db",
        "instance_class": "db.t3.micro",
        "multi_az": false,
        "password": "${random_password.db_password.result}",
        "publicly_accessible": false,
        "skip_final_snapshot": false,
        "username": "cloudcompose",
        "vpc_security_group_ids": [
          "${aws_security_group.default_sg.id}"
        ]
      }
    },
    "aws_db_subnet_group": {
      "db_sng": {
        "name": "prod-production-stack-db-sng",
        "subnet_ids": [
          "subnet-3",
          "subnet-4"
        ]
      }
    },
    "aws_ecs_service": {
      "web_service": {
        "cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/prod-cluster",
        "desired_count": 2,
        "launch_type": "FARGATE",
        "lifecycle": {
          "ignore_changes": [
            "desired_count"
          ]
        },
        "load_balancer": [
          {
            "container_name": "web",
            "container_port": 80,
            "target_group_arn": "${aws_lb_target_group.web_tg.arn}"
          }
        ],
        "name": "prod-production-stack-web",
        "network_configuration": {
          "assign_public_ip": false,
          "security_groups": [
            "${aws_security_group.default_sg.id}",
            "${aws_security_group.web_ingress_sg.id}"
          ],
          "subnets": [
            "subnet-3",
            "subnet-4"
          ]
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.web_discovery.arn}"
        },
        "task_definition": "${aws_ecs_task_definition.web_td.arn}"
      }
    },
    "aws_ecs_task_definition": {
      "cleanup_td": {
        "container_definitions": "[{\"command\":[\"echo\",\"cleaning up...\"],\"environment\":[],\"essential\":true,\"image\":\"busybox\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-group\":\"${aws_cloudwatch_log_group.cleanup_lg.name}\",\"awslogs-region\":\"us-east-1\",\"awslogs-stream-prefix\":\"ecs\"}},\"name\":\"cleanup\",\"portMappings\":[],\"secrets\":[]}]",
        "cpu": "256",
        "execution_role_arn": "${aws_iam_role.cleanup_exec_role.arn}",
        "family": "prod-production-stack-cleanup",
        "memory": "512",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "task_role_arn": "${aws_iam_role.cleanup_task_role.arn}"
      },
      "web_td": {
        "container_definitions": "[{\"environment\":[{\"name\":\"DB_HOST\",\"value\":\"${aws_db_instance.db_db.address}\"},{\"name\":\"REDIS_URL\",\"value\":\"redis://${aws_elasticache_cluster.cache_cache.cache_nodes[0].address}:6379\"}],\"essential\":true,\"image\":\"nginx:latest\",\"logConfiguration\":{\"logDriver\":\"awslogs\",\"options\":{\"awslogs-group\":\"${aws_cloudwatch_log_group.web_lg.name}\",\"awslogs-region\":\"us-east-1\",\"awslogs-stream-prefix\":\"ecs\"}},\"name\":\"web\",\"portMappings\":[{\"containerPort\":80,\"hostPort\":80,\"protocol\":\"tcp\"}],\"secrets\":[{\"name\":\"DB_PASSWORD\",\"valueFrom\":\"${aws_secretsmanager_secret.db_db_secret.arn}:password::\"},{\"name\":\"DB_USERNAME\",\"valueFrom\":\"${aws_secretsmanager_secret.db_db_secret.arn}:username::\"}]}]",
        "cpu": "1024",
        "execution_role_arn": "${aws_iam_role.web_exec_role.arn}",
        "family": "prod-production-stack-web",
        "memory": "2048",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "task_role_arn": "${aws_iam_role.web_task_role.arn}"
      }
    },
    "aws_elasticache_cluster": {
      "cache_cache": {
        "cluster_id": "prod-production-stack-cache",
        "engine": "redis",
        "node_type": "cache.t3.micro",
        "num_cache_nodes": 1,
        "security_group_ids": [
          "${aws_security_group.default_sg.id}"
        ],
        "subnet_group_name": "${aws_elasticache_subnet_group.cache_sng.name}"
      }
    },
    "aws_elasticache_subnet_group": {
      "cache_sng": {
        "name": "prod-production-stack-cache-sng",
        "subnet_ids": [
          "subnet-3",
          "subnet-4"
        ]
      }
    },
    "aws_iam_role": {
      "cleanup_eb_role": {
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Principal\":{\"Service\":\"events.amazonaws.com\"}}]}",
        "name": "prod-production-stack-cleanup-eb-role"
      },
      "cleanup_exec_role": {
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-production-stack-cleanup-exec-role"
      },
      "cleanup_task_role": {
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-production-stack-cleanup-task-role"
      },
      "web_exec_role": {
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-production-stack-web-exec-role"
      },
      "web_task_role": {
        "assume_role_policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Principal\":{\"Service\":\"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-production-stack-web-task-role"
      }
    },
    "aws_iam_role_policy": {
      "cleanup_eb_policy": {
        "name": "prod-production-stack-cleanup-eb-policy",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"ecs:RunTask\",\"Resource\":[\"${aws_ecs_task_definition.cleanup_td.arn}\"],\"Condition\":{\"ArnLike\":{\"ecs:cluster\":\"arn:aws:ecs:us-east-1:123456789012:cluster/prod-cluster\"}}},{\"Effect\":\"Allow\",\"Action\":\"iam:PassRole\",\"Resource\":[\"*\"],\"Condition\":{\"StringLike\":{\"iam:PassedToService\":\"ecs-tasks.amazonaws.com\"}}}]}",
        "role": "${aws_iam_role.cleanup_eb_role.name}"
      },
      "cleanup_exec_log_policy": {
        "name": "prod-production-stack-cleanup-exec-log-policy",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":[\"${aws_cloudwatch_log_group.cleanup_lg.arn}:*\"]}]}",
        "role": "${aws_iam_role.cleanup_exec_role.name}"
      },
      "web_exec_log_policy": {
        "name": "prod-production-stack-web-exec-log-policy",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":[\"${aws_cloudwatch_log_group.web_lg.arn}:*\"]}]}",
        "role": "${aws_iam_role.web_exec_role.name}"
      },
      "web_to_db_rds_secret": {
        "name": "prod-production-stack-web-db-rds-secret",
        "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"secretsmanager:GetSecretValue\"],\"Resource\":[\"${aws_secretsmanager_secret.db_db_secret.arn}\"]}]}",
        "role": "${aws_iam_role.web_exec_role.name}"
      }
    },
    "aws_lb_listener_rule": {
      "web_listener_rule": {
        "action": [
          {
            "target_group_arn": "${aws_lb_target_group.web_tg.arn}",
            "type": "forward"
          }
        ],
        "condition": [
          {
            "path_pattern": {
              "values": [
                "/*"
              ]
            }
          }
        ],
        "listener_arn": "arn:aws:lb:us-east-1:123456789012:listener/app/shared-alb/123/456",
        "priority": 32801
      }
    },
    "aws_lb_target_group": {
      "web_tg": {
        "health_check": {
          "enabled": true,
          "matcher": "200-399",
          "path": "/"
        },
        "name": "prod-production-stack-web-tg",
        "port": 80,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "vpc-123"
      }
    },
    "aws_secretsmanager_secret": {
      "db_db_secret": {
        "description": "Credentials for db RDS",
        "name": "prod-production-stack-db-credentials",
        "recovery_window_in_days": 0
      }
    },
    "aws_secretsmanager_secret_version": {
      "db_db_secret_v1": {
        "secret_id": "${aws_secretsmanager_secret.db_db_secret.id}",
        "secret_string": "{\"engine\":\"postgres\",\"password\":\"${random_password.db_password.result}\",\"username\":\"cloudcompose\"}"
      }
    },
    "aws_security_group": {
      "default_sg": {
        "description": "Network default of production-stack in prod",
        "name": "prod-production-stack-default",
        "vpc_id": "vpc-123"
      },
      "web_ingress_sg": {
        "description": "Load balancer ingress to web",
        "name": "prod-production-stack-web-ingress",
        "vpc_id": "vpc-123"
      }
    },
    "aws_security_group_rule": {
      "alb_to_web_rule": {
        "description": "Allow the load balancer to reach web",
        "from_port": 80,
        "protocol": "tcp",
        "security_group_id": "${aws_security_group.web_ingress_sg.id}",
        "source_security_group_id": "sg-alb0123456789",
        "to_port": 80,
        "type": "ingress"
      },
      "default_sg_egress_rule": {
        "cidr_blocks": [
          "0.0.0.0/0"
        ],
        "description": "Allow all outbound from network default",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.default_sg.id}",
        "to_port": 0,
        "type": "egress"
      },
      "default_sg_internal_rule": {
        "description": "Allow traffic within network default",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.default_sg.id}",
        "source_security_group_id": "${aws_security_group.default_sg.id}",
        "to_port": 0,
        "type": "ingress"
      }
    },
    "aws_service_discovery_private_dns_namespace": {
      "app": {
        "description": "Service discovery for production-stack in prod",
        "name": "prod-production-stack.internal",
        "vpc": "vpc-123"
      }
    },
    "aws_service_discovery_service": {
      "web_discovery": {
        "dns_config": {
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ],
          "namespace_id": "${aws_service_discovery_private_dns_namespace.app.id}",
          "routing_policy": "MULTIVALUE"
        },
        "health_check_custom_config": {
          "failure_threshold": 1
        },
        "name": "web"
      }
    },
    "aws_wafv2_web_acl": {
      "web_waf": {
        "default_action": {
          "allow": {}
        },
        "name": "prod-production-stack-web-waf",
        "provider": "aws.us_east_1",
        "rule": [
          {
            "name": "AWS-AWSManagedRulesCommonRuleSet",
            "override_action": {
              "none": {}
            },
            "priority": 1,
            "statement": {
              "managed_rule_group_statement": {
                "name": "AWSManagedRulesCommonRuleSet",
                "vendor_name": "AWS"
              }
            },
            "visibility_config": {
              "cloudwatch_metrics_enabled": true,
              "metric_name": "AWSManagedRulesCommonRuleSet",
              "sampled_requests_enabled": true
            }
          }
        ],
        "scope": "CLOUDFRONT",
        "visibility_config": {
          "cloudwatch_metrics_enabled": true,
          "metric_name": "webWAF",
          "sampled_requests_enabled": true
        }
      }
    },
    "random_id": {
      "db_snapshot": {
        "byte_length": 4
      }
    },
    "random_password": {
      "db_password": {
        "length": 20,
        "special": false
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}