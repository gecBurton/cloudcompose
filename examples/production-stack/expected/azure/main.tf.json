{
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 3.0"
      },
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "docker": {},
    "random": {}
  },
  "data": {
    "azurerm_client_config": {
      "current": {}
    },
    "azurerm_container_app_environment": {
      "main": {
        "name": "prod-env",
        "resource_group_name": "prod"
      }
    }
  },
  "resource": {
    "azurerm_container_app": {
      "cleanup": {
        "name": "prod-production-stack-cleanup",
        "resource_group_name": "prod",
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "revision_mode": "Single",
        "template": {
          "container": [
            {
              "name": "cleanup",
              "image": "busybox",
              "cpu": 0.25,
              "memory": "0.5Gi",
              "args": [
                "echo",
                "cleaning up..."
              ],
              "env": []
            }
          ],
          "min_replicas": 1,
          "max_replicas": 1
        },
        "identity": {
          "type": "SystemAssigned"
        }
      },
      "web": {
        "name": "prod-production-stack-web",
        "resource_group_name": "prod",
        "container_app_environment_id": "${data.azurerm_container_app_environment.main.id}",
        "revision_mode": "Single",
        "template": {
          "container": [
            {
              "name": "web",
              "image": "nginx:latest",
              "cpu": 0.5,
              "memory": "1Gi",
              "env": [
                {
                  "name": "DB_HOST",
                  "value": "db"
                },
                {
                  "name": "REDIS_URL",
                  "value": "redis://cache"
                },
                {
                  "name": "DB_URL",
                  "value": "postgresql://composey:${random_password.postgres_admin.result}@${azurerm_postgresql_flexible_server.main.fqdn}:5432/production_stack_db"
                },
                {
                  "name": "CACHE_URL",
                  "value": "postgresql://None:${azurerm_redis_cache.cache_redis.primary_access_key}@${azurerm_redis_cache.cache_redis.hostname}:6379/None"
                }
              ]
            }
          ],
          "min_replicas": 2,
          "max_replicas": 10,
          "http_scale_rule": [
            {
              "name": "http-default",
              "concurrent_requests": "100"
            }
          ]
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "transport": "auto",
          "traffic_weight": {
            "latest_revision": true,
            "percentage": 100
          }
        },
        "identity": {
          "type": "SystemAssigned"
        }
      }
    },
    "azurerm_postgresql_flexible_server": {
      "main": {
        "name": "prod-production-stack-pg",
        "resource_group_name": "prod",
        "location": "eastus",
        "version": "14",
        "sku_name": "B_Standard_B1ms",
        "storage_mb": 32768,
        "administrator_login": "composey",
        "administrator_password": "${random_password.postgres_admin.result}",
        "delegated_subnet_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet/subnets/infrastructure",
        "public_network_access_enabled": false
      }
    },
    "azurerm_postgresql_flexible_server_database": {
      "db_db": {
        "name": "production_stack_db",
        "server_id": "${azurerm_postgresql_flexible_server.main.id}",
        "charset": "UTF8",
        "collation": "en_US.utf8"
      }
    },
    "azurerm_key_vault": {
      "main": {
        "name": "prod-production-stack-kv",
        "resource_group_name": "prod",
        "location": "eastus",
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "purge_protection_enabled": false
      }
    },
    "azurerm_redis_cache": {
      "cache_redis": {
        "name": "prod-production-stack-cache",
        "resource_group_name": "prod",
        "location": "eastus",
        "sku_name": "Standard",
        "family": "C",
        "capacity": 1,
        "redis_version": "6",
        "enable_non_ssl_port": false,
        "minimum_tls_version": "1.2"
      }
    },
    "azurerm_cdn_profile": {
      "main": {
        "name": "prod-production-stack-cdn",
        "resource_group_name": "prod",
        "location": "eastus",
        "sku": "Standard_Microsoft"
      }
    },
    "azurerm_cdn_endpoint": {
      "web_cdn": {
        "name": "prod-production-stack-web-cdn",
        "profile_name": "${azurerm_cdn_profile.main.name}",
        "resource_group_name": "prod",
        "location": "eastus",
        "origin_host_header": "${azurerm_container_app.web.ingress[0].fqdn}",
        "origin": [
          {
            "name": "default",
            "host_name": "${azurerm_container_app.web.ingress[0].fqdn}",
            "http_port": 80,
            "https_port": 443
          }
        ],
        "is_http_allowed": false,
        "is_https_allowed": true,
        "optimization_type": "GeneralWebDelivery",
        "global_delivery_rule": {
          "cache_expiration_action": {
            "behavior": "Override",
            "duration": "1.00:00:00"
          }
        }
      }
    },
    "random_password": {
      "postgres_admin": {
        "length": 20,
        "special": false
      }
    }
  },
  "output": {
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    }
  }
}