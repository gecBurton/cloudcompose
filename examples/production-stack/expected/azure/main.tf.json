{
  "data": {
    "azurerm_client_config": {
      "current": {}
    }
  },
  "output": {
    "cdn_fqdn": {
      "description": "Public hostname of the Front Door endpoint fronting the CDN-enabled service.",
      "value": "${azurerm_cdn_frontdoor_endpoint.web.host_name}"
    },
    "fqdn": {
      "description": "Public hostname of the ingress-enabled service.",
      "value": "${azurerm_container_app.web.ingress[0].fqdn}"
    },
    "key_vault_name": {
      "description": "Name of the Key Vault holding managed-service/secrets/config credentials, if any.",
      "value": "${azurerm_key_vault.main.name}"
    }
  },
  "provider": {
    "azurerm": {
      "features": {}
    },
    "random": {},
    "time": {}
  },
  "resource": {
    "azurerm_cdn_frontdoor_endpoint": {
      "web": {
        "cdn_frontdoor_profile_id": "${azurerm_cdn_frontdoor_profile.main.id}",
        "name": "prod-production-stack-web-fd"
      }
    },
    "azurerm_cdn_frontdoor_firewall_policy": {
      "web": {
        "custom_rule": [
          {
            "action": "Block",
            "enabled": true,
            "match_condition": [
              {
                "match_values": [
                  "0"
                ],
                "match_variable": "RequestHeader",
                "negation_condition": false,
                "operator": "GreaterThanOrEqual",
                "selector": "Host"
              }
            ],
            "name": "RateLimit",
            "priority": 1,
            "rate_limit_duration_in_minutes": 1,
            "rate_limit_threshold": 100,
            "type": "RateLimitRule"
          }
        ],
        "mode": "Prevention",
        "name": "prodproductionstackwebwaf",
        "resource_group_name": "prod",
        "sku_name": "Standard_AzureFrontDoor"
      }
    },
    "azurerm_cdn_frontdoor_origin": {
      "web": {
        "cdn_frontdoor_origin_group_id": "${azurerm_cdn_frontdoor_origin_group.web.id}",
        "certificate_name_check_enabled": true,
        "host_name": "${azurerm_container_app.web.ingress[0].fqdn}",
        "http_port": 80,
        "https_port": 443,
        "name": "web",
        "origin_host_header": "${azurerm_container_app.web.ingress[0].fqdn}"
      }
    },
    "azurerm_cdn_frontdoor_origin_group": {
      "web": {
        "cdn_frontdoor_profile_id": "${azurerm_cdn_frontdoor_profile.main.id}",
        "health_probe": {
          "interval_in_seconds": 30,
          "path": "/",
          "protocol": "Https",
          "request_type": "HEAD"
        },
        "load_balancing": {},
        "name": "web"
      }
    },
    "azurerm_cdn_frontdoor_profile": {
      "main": {
        "name": "prod-production-stack-fd",
        "resource_group_name": "prod",
        "sku_name": "Standard_AzureFrontDoor"
      }
    },
    "azurerm_cdn_frontdoor_route": {
      "web": {
        "cdn_frontdoor_endpoint_id": "${azurerm_cdn_frontdoor_endpoint.web.id}",
        "cdn_frontdoor_origin_group_id": "${azurerm_cdn_frontdoor_origin_group.web.id}",
        "cdn_frontdoor_origin_ids": [
          "${azurerm_cdn_frontdoor_origin.web.id}"
        ],
        "forwarding_protocol": "HttpsOnly",
        "https_redirect_enabled": true,
        "name": "default",
        "patterns_to_match": [
          "/*"
        ],
        "supported_protocols": [
          "Http",
          "Https"
        ]
      }
    },
    "azurerm_cdn_frontdoor_security_policy": {
      "web": {
        "cdn_frontdoor_profile_id": "${azurerm_cdn_frontdoor_profile.main.id}",
        "name": "prod-production-stack-web-secpolicy",
        "security_policies": [
          {
            "firewall": [
              {
                "association": [
                  {
                    "domain": [
                      {
                        "cdn_frontdoor_domain_id": "${azurerm_cdn_frontdoor_endpoint.web.id}"
                      }
                    ],
                    "patterns_to_match": [
                      "/*"
                    ]
                  }
                ],
                "cdn_frontdoor_firewall_policy_id": "${azurerm_cdn_frontdoor_firewall_policy.web.id}"
              }
            ]
          }
        ]
      }
    },
    "azurerm_container_app": {
      "web": {
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "identity": {
          "identity_ids": [
            "${azurerm_user_assigned_identity.main.id}"
          ],
          "type": "UserAssigned"
        },
        "ingress": {
          "external_enabled": true,
          "target_port": 80,
          "traffic_weight": [
            {
              "latest_revision": true,
              "percentage": 100
            }
          ],
          "transport": "auto"
        },
        "name": "prod-production-stack-web",
        "resource_group_name": "prod",
        "revision_mode": "Single",
        "secret": [
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.web_redis_url_url.versionless_id}",
            "name": "web-redis-url-url"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.db_secret.versionless_id}",
            "name": "db-url"
          },
          {
            "identity": "${azurerm_user_assigned_identity.main.id}",
            "key_vault_secret_id": "${azurerm_key_vault_secret.cache_secret.versionless_id}",
            "name": "cache-url"
          }
        ],
        "template": {
          "container": [
            {
              "cpu": 1,
              "env": [
                {
                  "name": "DB_HOST",
                  "value": "${azurerm_postgresql_flexible_server.main.fqdn}"
                },
                {
                  "name": "REDIS_URL",
                  "secret_name": "web-redis-url-url"
                },
                {
                  "name": "DB_URL",
                  "secret_name": "db-url"
                },
                {
                  "name": "CACHE_URL",
                  "secret_name": "cache-url"
                }
              ],
              "image": "nginx:latest",
              "liveness_probe": [
                {
                  "path": "/",
                  "port": 80,
                  "transport": "HTTP"
                }
              ],
              "memory": "2Gi",
              "name": "web"
            }
          ],
          "custom_scale_rule": [
            {
              "custom_rule_type": "cpu",
              "metadata": {
                "type": "Utilization",
                "value": "70"
              },
              "name": "cpu-rule"
            },
            {
              "custom_rule_type": "memory",
              "metadata": {
                "type": "Utilization",
                "value": "80"
              },
              "name": "memory-rule"
            }
          ],
          "http_scale_rule": [
            {
              "concurrent_requests": "100",
              "name": "http-default"
            }
          ],
          "max_replicas": 10,
          "min_replicas": 2
        }
      }
    },
    "azurerm_container_app_environment": {
      "main": {
        "infrastructure_subnet_id": "${azurerm_subnet.infrastructure.id}",
        "internal_load_balancer_enabled": false,
        "location": "eastus",
        "log_analytics_workspace_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.OperationalInsights/workspaces/prod-logs",
        "name": "prod-production-stack-env",
        "resource_group_name": "prod"
      }
    },
    "azurerm_container_app_job": {
      "cleanup": {
        "container_app_environment_id": "${azurerm_container_app_environment.main.id}",
        "identity": {
          "type": "SystemAssigned"
        },
        "location": "eastus",
        "name": "prod-production-stack-cleanup",
        "replica_retry_limit": 1,
        "replica_timeout_in_seconds": 1800,
        "resource_group_name": "prod",
        "schedule_trigger_config": [
          {
            "cron_expression": "0 2 * * *"
          }
        ],
        "template": [
          {
            "container": [
              {
                "args": [
                  "echo",
                  "cleaning up..."
                ],
                "cpu": 0.25,
                "env": [],
                "image": "busybox",
                "memory": "0.5Gi",
                "name": "cleanup"
              }
            ]
          }
        ]
      }
    },
    "azurerm_key_vault": {
      "main": {
        "location": "eastus",
        "name": "prod-production-stack-kv",
        "purge_protection_enabled": false,
        "rbac_authorization_enabled": true,
        "resource_group_name": "prod",
        "sku_name": "standard",
        "soft_delete_retention_days": 7,
        "tenant_id": "${data.azurerm_client_config.current.tenant_id}"
      }
    },
    "azurerm_key_vault_secret": {
      "cache_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-production-stack-cache-password",
        "value": "${azurerm_managed_redis.cache_redis.default_database[0].primary_access_key}"
      },
      "db_secret": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-production-stack-db-password",
        "value": "${random_password.postgres_admin.result}"
      },
      "web_redis_url_url": {
        "depends_on": [
          "time_sleep.kv_role_propagation"
        ],
        "key_vault_id": "${azurerm_key_vault.main.id}",
        "lifecycle": {
          "ignore_changes": [
            "value"
          ]
        },
        "name": "prod-production-stack-web-redis-url",
        "value": "redis://${azurerm_managed_redis.cache_redis.hostname}:10000"
      }
    },
    "azurerm_managed_redis": {
      "cache_redis": {
        "default_database": [
          {
            "access_keys_authentication_enabled": true,
            "client_protocol": "Encrypted",
            "eviction_policy": "AllKeysLRU"
          }
        ],
        "high_availability_enabled": false,
        "location": "eastus",
        "name": "prod-production-stack-cache",
        "public_network_access": "Disabled",
        "resource_group_name": "prod",
        "sku_name": "Balanced_B0"
      }
    },
    "azurerm_monitor_diagnostic_setting": {
      "pg_diag": {
        "enabled_log": [
          {
            "category": "PostgreSQLLogs"
          }
        ],
        "log_analytics_workspace_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.OperationalInsights/workspaces/prod-logs",
        "name": "prod-production-stack-pg-diag",
        "target_resource_id": "${azurerm_postgresql_flexible_server.main.id}"
      }
    },
    "azurerm_postgresql_flexible_server": {
      "main": {
        "administrator_login": "cloudcompose",
        "administrator_password": "${random_password.postgres_admin.result}",
        "backup_retention_days": 7,
        "delegated_subnet_id": "${azurerm_subnet.postgresql.id}",
        "depends_on": [
          "azurerm_private_dns_zone_virtual_network_link.postgresql"
        ],
        "lifecycle": {
          "ignore_changes": [
            "zone"
          ]
        },
        "location": "eastus",
        "name": "prod-production-stack-pg",
        "private_dns_zone_id": "${azurerm_private_dns_zone.postgresql.id}",
        "public_network_access_enabled": false,
        "resource_group_name": "prod",
        "sku_name": "B_Standard_B1ms",
        "storage_mb": 32768,
        "version": "14"
      }
    },
    "azurerm_postgresql_flexible_server_database": {
      "db_db": {
        "charset": "UTF8",
        "collation": "en_US.utf8",
        "name": "production_stack_db",
        "server_id": "${azurerm_postgresql_flexible_server.main.id}"
      }
    },
    "azurerm_private_dns_zone": {
      "postgresql": {
        "name": "production-stack-postgresql.postgres.database.azure.com",
        "resource_group_name": "prod"
      },
      "redis": {
        "name": "privatelink.redis.azure.net",
        "resource_group_name": "prod"
      }
    },
    "azurerm_private_dns_zone_virtual_network_link": {
      "postgresql": {
        "name": "production-stack-postgresql-link",
        "private_dns_zone_name": "${azurerm_private_dns_zone.postgresql.name}",
        "registration_enabled": false,
        "resource_group_name": "prod",
        "virtual_network_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet"
      },
      "redis": {
        "name": "production-stack-redis-link",
        "private_dns_zone_name": "${azurerm_private_dns_zone.redis.name}",
        "registration_enabled": false,
        "resource_group_name": "prod",
        "virtual_network_id": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/prod/providers/Microsoft.Network/virtualNetworks/prod-vnet"
      }
    },
    "azurerm_private_endpoint": {
      "cache_redis_pe": {
        "location": "eastus",
        "name": "prod-production-stack-cache-redis-pe",
        "private_dns_zone_group": {
          "name": "default",
          "private_dns_zone_ids": [
            "${azurerm_private_dns_zone.redis.id}"
          ]
        },
        "private_service_connection": [
          {
            "is_manual_connection": false,
            "name": "prod-production-stack-cache-redis-psc",
            "private_connection_resource_id": "${azurerm_managed_redis.cache_redis.id}",
            "subresource_names": [
              "redisEnterprise"
            ]
          }
        ],
        "resource_group_name": "prod",
        "subnet_id": "${azurerm_subnet.redis.id}"
      }
    },
    "azurerm_role_assignment": {
      "kv_role": {
        "principal_id": "${azurerm_user_assigned_identity.main.principal_id}",
        "role_definition_name": "Key Vault Secrets User",
        "scope": "${azurerm_key_vault.main.id}"
      }
    },
    "azurerm_subnet": {
      "infrastructure": {
        "address_prefixes": [
          "10.0.128.0/26"
        ],
        "delegation": [
          {
            "name": "container-apps",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.App/environments"
              }
            ]
          }
        ],
        "name": "prod-production-stack-infrastructure",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "mysql": {
        "address_prefixes": [
          "10.0.128.128/26"
        ],
        "delegation": [
          {
            "name": "mysql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforMySQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-production-stack-mysql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "postgresql": {
        "address_prefixes": [
          "10.0.128.64/26"
        ],
        "delegation": [
          {
            "name": "postgresql-flexible-server",
            "service_delegation": [
              {
                "actions": [
                  "Microsoft.Network/virtualNetworks/subnets/join/action"
                ],
                "name": "Microsoft.DBforPostgreSQL/flexibleServers"
              }
            ]
          }
        ],
        "name": "prod-production-stack-postgresql",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      },
      "redis": {
        "address_prefixes": [
          "10.0.128.192/26"
        ],
        "name": "prod-production-stack-redis",
        "resource_group_name": "prod",
        "virtual_network_name": "prod-vnet"
      }
    },
    "azurerm_user_assigned_identity": {
      "main": {
        "location": "eastus",
        "name": "prod-production-stack-identity",
        "resource_group_name": "prod"
      }
    },
    "random_password": {
      "postgres_admin": {
        "length": 20,
        "special": false
      }
    },
    "time_sleep": {
      "kv_role_propagation": {
        "create_duration": "90s",
        "depends_on": [
          "azurerm_role_assignment.kv_role"
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "azurerm": {
        "source": "hashicorp/azurerm",
        "version": "~> 4.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      },
      "time": {
        "source": "hashicorp/time",
        "version": "~> 0.13"
      }
    }
  }
}