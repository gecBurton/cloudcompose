{
  "provider": {
    "docker": {},
    "google": {
      "project": "my-project-123",
      "region": "us-central1"
    },
    "random": {}
  },
  "resource": {
    "google_cloud_run_service": {
      "api": {
        "autogenerate_revision_name": true,
        "ingress": "internal",
        "location": "us-central1",
        "name": "prod-service-discovery-api",
        "project_id": "my-project-123",
        "template": {
          "metadata": {
            "annotations": {
              "autoscaling.knative.dev/maxScale": "1",
              "autoscaling.knative.dev/minScale": "1",
              "run.googleapis.com/cpu-throttling": "true",
              "run.googleapis.com/execution-environment": "gen2"
            }
          },
          "spec": {
            "containers": [
              {
                "image": "nginxdemos/hello:plain-text",
                "resources": {
                  "limits": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  }
                }
              }
            ],
            "service_account_name": "my-project-123-compute@developer.gserviceaccount.com"
          }
        },
        "traffic": [
          {
            "latest_revision": true,
            "percent": 100
          }
        ]
      },
      "web": {
        "autogenerate_revision_name": true,
        "ingress": "all",
        "location": "us-central1",
        "name": "prod-service-discovery-web",
        "project_id": "my-project-123",
        "template": {
          "metadata": {
            "annotations": {
              "autoscaling.knative.dev/maxScale": "1",
              "autoscaling.knative.dev/minScale": "1",
              "run.googleapis.com/cpu-throttling": "true",
              "run.googleapis.com/execution-environment": "gen2"
            }
          },
          "spec": {
            "containers": [
              {
                "args": [
                  "python",
                  "-c",
                  "import os, urllib.request\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        url = os.environ[\"API_URL\"]\n        try:\n            with urllib.request.urlopen(url, timeout=5) as r:\n                body = \"web reached api at %s:\\n%s\" % (url, r.read().decode())\n        except Exception as e:\n            body = \"web could not reach api at %s: %r\\n\" % (url, e)\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"text/plain\")\n        self.end_headers()\n        self.wfile.write(body.encode())\n\nHTTPServer((\"\", 80), Handler).serve_forever()\n"
                ],
                "env": [
                  {
                    "name": "API_URL",
                    "value": "http://api"
                  }
                ],
                "image": "python:3.12-alpine",
                "resources": {
                  "limits": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  }
                }
              }
            ],
            "service_account_name": "my-project-123-compute@developer.gserviceaccount.com"
          }
        },
        "traffic": [
          {
            "latest_revision": true,
            "percent": 100
          }
        ]
      }
    }
  },
  "terraform": {
    "required_providers": {
      "docker": {
        "source": "kreuzwerker/docker",
        "version": "~> 3.0"
      },
      "google": {
        "source": "hashicorp/google",
        "version": "~> 5.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}