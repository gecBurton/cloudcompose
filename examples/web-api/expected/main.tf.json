{
  "provider": {
    "aws": {
      "region": "us-east-1"
    }
  },
  "resource": {
    "aws_cloudwatch_log_group": {
      "api_lg": {
        "name": "/ecs/prod-web-api-api",
        "retention_in_days": 7
      },
      "web_lg": {
        "name": "/ecs/prod-web-api-web",
        "retention_in_days": 7
      }
    },
    "aws_ecs_service": {
      "api_service": {
        "cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/prod-cluster",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "load_balancer": [],
        "name": "prod-web-api-api",
        "network_configuration": {
          "assign_public_ip": false,
          "security_groups": [
            "${aws_security_group.app_sg.id}"
          ],
          "subnets": [
            "subnet-3",
            "subnet-4"
          ]
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.api_discovery.arn}"
        },
        "task_definition": "${aws_ecs_task_definition.api_td.arn}"
      },
      "web_service": {
        "cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/prod-cluster",
        "desired_count": 1,
        "launch_type": "FARGATE",
        "load_balancer": [
          {
            "container_name": "web",
            "container_port": 80,
            "target_group_arn": "${aws_lb_target_group.web_tg.arn}"
          }
        ],
        "name": "prod-web-api-web",
        "network_configuration": {
          "assign_public_ip": false,
          "security_groups": [
            "${aws_security_group.app_sg.id}",
            "${aws_security_group.web_ingress_sg.id}"
          ],
          "subnets": [
            "subnet-3",
            "subnet-4"
          ]
        },
        "service_registries": {
          "registry_arn": "${aws_service_discovery_service.web_discovery.arn}"
        },
        "task_definition": "${aws_ecs_task_definition.web_td.arn}"
      }
    },
    "aws_ecs_task_definition": {
      "api_td": {
        "container_definitions": "[{\"name\": \"api\", \"image\": \"nginxdemos/hello:plain-text\", \"essential\": true, \"portMappings\": [{\"containerPort\": 80, \"hostPort\": 80, \"protocol\": \"tcp\"}], \"environment\": [], \"secrets\": [], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.api_lg.name}\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"ecs\"}}}]",
        "cpu": "256",
        "execution_role_arn": "${aws_iam_role.api_exec_role.arn}",
        "family": "prod-web-api-api",
        "memory": "512",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "task_role_arn": "${aws_iam_role.api_task_role.arn}"
      },
      "web_td": {
        "container_definitions": "[{\"name\": \"web\", \"image\": \"nginxdemos/hello:plain-text\", \"essential\": true, \"portMappings\": [{\"containerPort\": 80, \"hostPort\": 80, \"protocol\": \"tcp\"}], \"environment\": [{\"name\": \"API_URL\", \"value\": \"http://api.prod-web-api.internal:80\"}], \"secrets\": [], \"logConfiguration\": {\"logDriver\": \"awslogs\", \"options\": {\"awslogs-group\": \"${aws_cloudwatch_log_group.web_lg.name}\", \"awslogs-region\": \"us-east-1\", \"awslogs-stream-prefix\": \"ecs\"}}}]",
        "cpu": "256",
        "execution_role_arn": "${aws_iam_role.web_exec_role.arn}",
        "family": "prod-web-api-web",
        "memory": "512",
        "network_mode": "awsvpc",
        "requires_compatibilities": [
          "FARGATE"
        ],
        "task_role_arn": "${aws_iam_role.web_task_role.arn}"
      }
    },
    "aws_iam_role": {
      "api_exec_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-web-api-api-exec-role"
      },
      "api_task_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-web-api-api-task-role"
      },
      "web_exec_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-web-api-web-exec-role"
      },
      "web_task_role": {
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": {\"Service\": \"ecs-tasks.amazonaws.com\"}}]}",
        "name": "prod-web-api-web-task-role"
      }
    },
    "aws_iam_role_policy": {
      "api_exec_log_policy": {
        "name": "prod-web-api-api-exec-log-policy",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": [\"${aws_cloudwatch_log_group.api_lg.arn}:*\"]}]}",
        "role": "${aws_iam_role.api_exec_role.name}"
      },
      "web_exec_log_policy": {
        "name": "prod-web-api-web-exec-log-policy",
        "policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": [\"${aws_cloudwatch_log_group.web_lg.arn}:*\"]}]}",
        "role": "${aws_iam_role.web_exec_role.name}"
      }
    },
    "aws_lb_listener_rule": {
      "web_listener_rule": {
        "action": [
          {
            "target_group_arn": "${aws_lb_target_group.web_tg.arn}",
            "type": "forward"
          }
        ],
        "condition": [
          {
            "path_pattern": {
              "values": [
                "/*"
              ]
            }
          }
        ],
        "listener_arn": "arn:aws:lb:us-east-1:123456789012:listener/app/shared-alb/123/456",
        "priority": 31001
      }
    },
    "aws_lb_target_group": {
      "web_tg": {
        "health_check": {
          "enabled": true,
          "matcher": "200-399",
          "path": "/"
        },
        "name": "prod-web-api-web-tg",
        "port": 80,
        "protocol": "HTTP",
        "target_type": "ip",
        "vpc_id": "vpc-123"
      }
    },
    "aws_security_group": {
      "app_sg": {
        "description": "Network app of web-api in prod",
        "name": "prod-web-api-app",
        "vpc_id": "vpc-123"
      },
      "web_ingress_sg": {
        "description": "Load balancer ingress to web",
        "name": "prod-web-api-web-ingress",
        "vpc_id": "vpc-123"
      }
    },
    "aws_security_group_rule": {
      "alb_to_web_rule": {
        "description": "Allow the load balancer to reach web",
        "from_port": 80,
        "protocol": "tcp",
        "security_group_id": "${aws_security_group.web_ingress_sg.id}",
        "source_security_group_id": "sg-alb0123456789",
        "to_port": 80,
        "type": "ingress"
      },
      "app_sg_egress_rule": {
        "cidr_blocks": [
          "0.0.0.0/0"
        ],
        "description": "Allow all outbound from network app",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.app_sg.id}",
        "to_port": 0,
        "type": "egress"
      },
      "app_sg_internal_rule": {
        "description": "Allow traffic within network app",
        "from_port": 0,
        "protocol": "-1",
        "security_group_id": "${aws_security_group.app_sg.id}",
        "source_security_group_id": "${aws_security_group.app_sg.id}",
        "to_port": 0,
        "type": "ingress"
      }
    },
    "aws_service_discovery_private_dns_namespace": {
      "app": {
        "description": "Service discovery for web-api in prod",
        "name": "prod-web-api.internal",
        "vpc": "vpc-123"
      }
    },
    "aws_service_discovery_service": {
      "api_discovery": {
        "dns_config": {
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ],
          "namespace_id": "${aws_service_discovery_private_dns_namespace.app.id}",
          "routing_policy": "MULTIVALUE"
        },
        "health_check_custom_config": {
          "failure_threshold": 1
        },
        "name": "api"
      },
      "web_discovery": {
        "dns_config": {
          "dns_records": [
            {
              "ttl": 10,
              "type": "A"
            }
          ],
          "namespace_id": "${aws_service_discovery_private_dns_namespace.app.id}",
          "routing_policy": "MULTIVALUE"
        },
        "health_check_custom_config": {
          "failure_threshold": 1
        },
        "name": "web"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws",
        "version": "~> 5.0"
      },
      "random": {
        "source": "hashicorp/random",
        "version": "~> 3.6"
      }
    }
  }
}